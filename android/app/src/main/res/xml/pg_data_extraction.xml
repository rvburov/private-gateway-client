<?xml version="1.0" encoding="utf-8"?>
<!-- Серверы и ключи в резервную копию Google и перенос на другое устройство не попадают: ключ шифрования — в Android
     Keystore этого устройства, копия без него бесполезна, а открытым текстом ее отдавать нельзя. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
