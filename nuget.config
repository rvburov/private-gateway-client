<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Кеши NuGet лежат внутри проекта, в packages/ (аналог venv): системный диск не засоряется,
    рабочие папки агентов берут пакеты из кеша основной (см. Directory.Build.props).
    packages/ исключена в .gitignore. Пути — только через «/»: обратный слеш на Linux создает
    папку с «\» в имени.
  -->
  <config>
    <add key="globalPackagesFolder" value="packages/packages" />
    <add key="http_cacheFolder" value="packages/http-cache" />
    <add key="pluginsCacheFolder" value="packages/plugins-cache" />
  </config>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
