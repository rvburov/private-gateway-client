<!--
  Установщик Windows (MSI, WiX v5) — scripts/package-windows.sh: папка сборки выпуска (bindpath App), версия MSI (Version,
  только цифры SemVer), значок (Icon).
  - Программа — в Program Files\Private Gateway (на всю машину), ярлык в меню «Пуск» с AUMID окна — уведомления
    приходят от имени программы.
  - Служба ставится той же командой, что из окна: PrivateGateway.Service.exe install для владельца — свойство OWNER (SID,
    его передает окно при обновлении), по умолчанию тот, кто ставит (UserSID), — копия в Program Files\Private
    Gateway\Service, состояние в ServiceState, запуск с Windows. Не встала — установка откатывается.
  - Обновление службу не удаляет: install новой версии заменяет ее атомарно (новая копия рядом, прежняя возвращается,
    если новая не запустилась). Откат неудачной первой установки удаляет службу, а неудачного обновления — нет: прежняя
    служба уже на месте, а MSI возвращает прежние файлы программы. MSI прежней версии ставится поверх новой (понижение
    версии разрешено — откат на прежнюю версию) тем же путем: служба заменяется, ее состояние остается.
  - Удаление (не обновление) сначала удаляет службу: uninstall снимает блок при обрыве и удаляет папки службы и ее
    состояния — машина не остается без сети.
  Файлы пользователя (настройки окна в LocalAppData) и чужие файлы в папке программы установщик не трогает.
  - Мастер установки, как у обычных программ (решение 487): приветствие → папка установки → установка (тут Windows
    спрашивает права администратора) → «Готово» с флажком «Запустить Private Gateway». Лицензионного шага нет. Язык
    мастера — русский (культура ru-RU, scripts/package-windows.sh). Тихая установка (msiexec /qn — обновление из окна,
    смоук CI) идет без мастера, как раньше.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Private Gateway" Manufacturer="Private Gateway" Version="$(Version)" UpgradeCode="b3f677bb-fd84-4ddd-b04c-8cf67f3ea5c3"
           Scope="perMachine" Compressed="yes" Language="1049" Codepage="1251">
    <!-- Понижение версии разрешено: откат на прежнюю версию из «О программе» ставит ее MSI поверх новой. -->
    <MajorUpgrade Schedule="afterInstallInitialize" AllowDowngrades="yes" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(Icon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/rvburov/private-gateway-client" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- Папка, выбранная в мастере, — и для обновлений: тихое обновление из окна (без мастера) ставит туда же, а не в
         Program Files по умолчанию. -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="SavedInstallFolder" Root="HKLM" Key="Software\Private Gateway" Name="InstallFolder" Type="raw" Bitness="always64" />
    </Property>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Private Gateway" />
    </StandardDirectory>

    <ComponentGroup Id="App" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.App)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="AppShortcut" Name="Private Gateway" Target="[INSTALLFOLDER]PrivateGateway.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon">
          <!-- Тот же AUMID, что регистрирует окно для уведомлений (WindowsToastNotifier.AppId). -->
          <ShortcutProperty Key="System.AppUserModel.ID" Value="PrivateGateway.Client" />
        </Shortcut>
        <RegistryValue Root="HKLM" Key="Software\Private Gateway" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Private Gateway" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" />
      </Component>
    </StandardDirectory>

    <!-- Мастер: стандартный WixUI_InstallDir без шага лицензии — «Далее» с приветствия ведет сразу к выбору папки. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <!-- «Запустить Private Gateway» на последнем шаге: окно — от имени пользователя, а не от установщика с правами. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Запустить Private Gateway" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <!-- Путь — после выбора папки (CostFinalize): Property со ссылкой на другое свойство WiX не подставляет. -->
    <SetProperty Id="WixShellExecTarget" Value="[INSTALLFOLDER]PrivateGateway.exe" After="CostFinalize" Sequence="ui" />
    <CustomAction Id="LaunchApp" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" />

    <Feature Id="Main">
      <ComponentGroupRef Id="App" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Служба: команды самой службы без окна консоли (WixQuietExec), от SYSTEM. Владелец — OWNER, иначе тот, кто ставит. -->
    <Property Id="OWNER" Secure="yes" />
    <SetProperty Id="OWNER" Value="[UserSID]" Before="SetInstallService" Sequence="execute" Condition="NOT OWNER" />
    <SetProperty Id="InstallService" Value="&quot;[INSTALLFOLDER]PrivateGateway.Service.exe&quot; --install --owner [OWNER]"
                 Before="InstallService" Sequence="execute" />
    <CustomAction Id="InstallService" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="check" />

    <SetProperty Id="RollbackInstallService" Value="&quot;[INSTALLFOLDER]PrivateGateway.Service.exe&quot; --uninstall"
                 Before="RollbackInstallService" Sequence="execute" />
    <CustomAction Id="RollbackInstallService" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="rollback" Impersonate="no" Return="ignore" />

    <SetProperty Id="UninstallService" Value="&quot;[INSTALLFOLDER]PrivateGateway.Service.exe&quot; --uninstall"
                 Before="UninstallService" Sequence="execute" />
    <CustomAction Id="UninstallService" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RollbackInstallService" After="InstallFiles" Condition="NOT REMOVE AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="InstallService" After="RollbackInstallService" Condition="NOT REMOVE" />
      <Custom Action="UninstallService" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
