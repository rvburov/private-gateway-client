<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Интерфейс на Avalonia: окна, модели представлений, тема из design-tokens.json.
    Сети, сокетов и запуска программ здесь нет (PgNoNetwork) — все через службу по IPC.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>PrivateGateway</AssemblyName>
    <PgNoNetwork>true</PgNoNetwork>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Client.Core/Client.Core.csproj" />
    <ProjectReference Include="../Client.Contracts/Client.Contracts.csproj" />
    <ProjectReference Include="../Client.Application/Client.Application.csproj" />
    <ProjectReference Include="../Client.Infrastructure/Client.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <!-- Тексты RU/EN — общие для всех приложений (shared/specifications/localization). -->
    <EmbeddedResource Include="../../../shared/specifications/localization/*.json"
                      LogicalName="loc.%(Filename).json" />
    <!-- Открытые компоненты для «О программе» — тот же список, что в THIRD-PARTY-NOTICES выпуска. -->
    <EmbeddedResource Include="../../../shared/licenses/components.json" LogicalName="open-components.json" />
  </ItemGroup>

</Project>
