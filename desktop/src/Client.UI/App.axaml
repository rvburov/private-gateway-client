<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PrivateGateway.Client.UI.ViewModels"
             xmlns:views="using:PrivateGateway.Client.UI.Views"
             xmlns:conv="using:PrivateGateway.Client.UI.Converters"
             x:Class="PrivateGateway.Client.UI.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://PrivateGateway/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://PrivateGateway/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:ToneBrushConverter x:Key="ToneBrush" />
      <conv:CheckBrushConverter x:Key="CheckBrush" />
      <conv:IconKeyConverter x:Key="IconKey" />
      <conv:UpperConverter x:Key="Upper" />
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:MainPageViewModel">
      <views:MainPage />
    </DataTemplate>
    <DataTemplate DataType="vm:ServersPageViewModel">
      <views:ServersPage />
    </DataTemplate>
    <DataTemplate DataType="vm:DialogViewModel">
      <views:DialogView />
    </DataTemplate>
    <DataTemplate DataType="vm:ServerCardViewModel">
      <views:ServerCardView />
    </DataTemplate>
    <DataTemplate DataType="vm:ImportPageViewModel">
      <views:ImportPage />
    </DataTemplate>
    <DataTemplate DataType="vm:CheckPageViewModel">
      <views:CheckPage />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsPageViewModel">
      <views:SettingsPage />
    </DataTemplate>
    <DataTemplate DataType="vm:SubscriptionsPageViewModel">
      <views:SubscriptionsPage />
    </DataTemplate>
    <DataTemplate DataType="vm:SubscriptionEditViewModel">
      <views:SubscriptionEditView />
    </DataTemplate>
    <DataTemplate DataType="vm:ProtectionPageViewModel">
      <views:ProtectionPage />
    </DataTemplate>
    <DataTemplate DataType="vm:DnsAddressViewModel">
      <views:DnsAddressView />
    </DataTemplate>
    <DataTemplate DataType="vm:CorePageViewModel">
      <views:CorePage />
    </DataTemplate>
    <DataTemplate DataType="vm:MtuViewModel">
      <views:MtuView />
    </DataTemplate>
    <DataTemplate DataType="vm:RoutingPageViewModel">
      <views:RoutingPage />
    </DataTemplate>
    <DataTemplate DataType="vm:SiteRuleEditViewModel">
      <views:SiteRuleEditView />
    </DataTemplate>
    <DataTemplate DataType="vm:NetworkPageViewModel">
      <views:NetworkPage />
    </DataTemplate>
    <DataTemplate DataType="vm:ProbePageViewModel">
      <views:ProbePage />
    </DataTemplate>
    <DataTemplate DataType="vm:ConnectionsPageViewModel">
      <views:ConnectionsPage />
    </DataTemplate>
    <DataTemplate DataType="vm:ComparePageViewModel">
      <views:ComparePage />
    </DataTemplate>
    <DataTemplate DataType="vm:BackupPageViewModel">
      <views:BackupPage />
    </DataTemplate>
    <DataTemplate DataType="vm:RestoreBackupViewModel">
      <views:RestoreBackupView />
    </DataTemplate>
    <DataTemplate DataType="vm:WelcomePageViewModel">
      <views:WelcomePage />
    </DataTemplate>
    <DataTemplate DataType="vm:ProblemPageViewModel">
      <views:ProblemPage />
    </DataTemplate>
    <DataTemplate DataType="vm:AboutPageViewModel">
      <views:AboutPage />
    </DataTemplate>
    <DataTemplate DataType="vm:AboutSheetViewModel">
      <views:AboutSheetView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://PrivateGateway/Themes/Styles.axaml" />
  </Application.Styles>
</Application>
