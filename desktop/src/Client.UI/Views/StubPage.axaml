<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PrivateGateway.Client.UI.ViewModels"
             x:Class="PrivateGateway.Client.UI.Views.StubPage"
             x:DataType="vm:StubPageViewModel">
  <StackPanel Margin="20,16,20,0" Spacing="10">
    <TextBlock Classes="h1" Text="{Binding Title}" />
    <TextBlock Classes="small" Text="{Binding Text}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
