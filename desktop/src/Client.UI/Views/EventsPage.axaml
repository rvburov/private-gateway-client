<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PrivateGateway.Client.UI.ViewModels"
             xmlns:c="using:PrivateGateway.Client.UI.Controls"
             xmlns:l="using:PrivateGateway.Client.UI.Localization"
             x:Class="PrivateGateway.Client.UI.Views.EventsPage"
             x:DataType="vm:EventsPageViewModel">
  <!-- События сети — сетевая лаборатория (этап 8, экрана в макете нет — по дизайн-системе, как «Проверка»): лента событий с
       объяснениями, новые сверху; новое событие въезжает сверху и проявляется. Подстраница «Проверки». -->
  <UserControl.Styles>
    <Style Selector="Border.eventRow">
      <Setter Property="RenderTransform" Value="translateY(0px)" />
      <Style.Animations>
        <Animation Duration="0:0:0.35" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-8" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <Grid Height="60" Margin="8,0,8,0" ColumnDefinitions="Auto,*">
      <Button x:Name="BackButton" Classes="icon" Command="{Binding BackCommand}"
              ToolTip.Tip="{l:L common.back}" AutomationProperties.Name="{l:L common.back}">
        <c:Icon Data="{StaticResource Icon.Back}" Width="22" Height="22" StrokeThickness="2.2" />
      </Button>
      <TextBlock Grid.Column="1" Classes="h1" Text="{l:L page.events.title}" VerticalAlignment="Center"
                 Margin="4,0,0,0" TextTrimming="CharacterEllipsis" />
    </Grid>

    <ScrollViewer Grid.Row="1" Classes="page">
      <StackPanel Margin="20,0" Spacing="12">
        <TextBlock Classes="caption" Text="{l:L events.note}" TextWrapping="Wrap" Margin="6,0"
                   LineHeight="{StaticResource PgLineHeight.Body}" />

        <Border Classes="segments" AutomationProperties.Name="{l:L lab.mode}">
          <UniformGrid Rows="1">
            <RadioButton x:Name="BeginnerMode" Classes="segment" GroupName="eventsMode" IsChecked="{Binding IsBeginner}"
                         Content="{l:L lab.mode.beginner}" AutomationProperties.Name="{l:L lab.mode.beginner}" />
            <RadioButton x:Name="ExpertMode" Classes="segment" GroupName="eventsMode" IsChecked="{Binding IsExpert}"
                         Content="{l:L lab.mode.expert}" AutomationProperties.Name="{l:L lab.mode.expert}" />
          </UniformGrid>
        </Border>

        <Border x:Name="Empty" Classes="card" Padding="16,14" IsVisible="{Binding !HasEvents}">
          <TextBlock Text="{l:L events.empty}" TextWrapping="Wrap" LineHeight="{StaticResource PgLineHeight.Body}"
                     Foreground="{StaticResource PgBrush.Text.Primary}" />
        </Border>

        <ItemsControl x:Name="EventList" ItemsSource="{Binding Rows}" IsVisible="{Binding HasEvents}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:EventRowViewModel">
              <Border Classes="card eventRow" Padding="16,12" AutomationProperties.Name="{Binding Title}">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Width="22" Height="22" CornerRadius="11" VerticalAlignment="Top" Margin="0,1,0,0"
                          Background="{Binding State, Converter={StaticResource CheckBrush}, ConverterParameter=Dot}">
                    <c:Icon Data="{Binding Icon, Converter={StaticResource IconKey}}" Width="12" Height="12"
                            StrokeThickness="3.2" Foreground="{StaticResource PgBrush.Surface.Solid}" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="strong" Text="{Binding Title}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Time}" Margin="8,0,0,0"
                                 FontFamily="{StaticResource PgFont.Mono}" VerticalAlignment="Top" />
                    </Grid>
                    <TextBlock Classes="caption" Text="{Binding Detail}" IsVisible="{Binding HasDetail}"
                               FontFamily="{StaticResource PgFont.Mono}" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="{StaticResource PgLineHeight.Body}"
                               Foreground="{StaticResource PgBrush.Text.Primary}" />
                    <TextBlock Classes="caption" Text="{Binding Expert}" IsVisible="{Binding HasExpert}" TextWrapping="Wrap"
                               LineHeight="{StaticResource PgLineHeight.Body}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Запас под островок: содержимое прокручивается под ним -->
        <Border Height="{StaticResource PgLayout.ScrollBottomPadding}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
