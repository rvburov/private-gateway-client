<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PrivateGateway.Client.UI.ViewModels"
             xmlns:c="using:PrivateGateway.Client.UI.Controls"
             xmlns:l="using:PrivateGateway.Client.UI.Localization"
             x:Class="PrivateGateway.Client.UI.Views.AboutSheetView"
             x:DataType="vm:AboutSheetViewModel">
  <!-- Лист «О программе» (доска 15): лицензии открытых компонентов или политика конфиденциальности. -->
  <DockPanel AutomationProperties.Name="{Binding Title}">
    <Border DockPanel.Dock="Top" Width="40" Height="4" CornerRadius="2" HorizontalAlignment="Center"
            Background="{StaticResource PgBrush.Control.Grabber}" />

    <Grid DockPanel.Dock="Top" Margin="0,12,0,0" ColumnDefinitions="*,Auto">
      <TextBlock x:Name="SheetTitle" Classes="status" Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="1" Classes="icon" Width="40" Height="40" Command="{Binding CloseCommand}"
              Foreground="{StaticResource PgBrush.Text.Secondary}"
              ToolTip.Tip="{l:L card.close}" AutomationProperties.Name="{l:L card.close}">
        <c:Icon Data="{StaticResource Icon.Close}" Width="20" Height="20" StrokeThickness="2.2" />
      </Button>
    </Grid>

    <ScrollViewer Margin="0,12,0,0">
      <StackPanel Spacing="12" Margin="0,0,0,16">
        <TextBlock x:Name="SheetText" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="20" />
        <ItemsControl x:Name="ComponentList" ItemsSource="{Binding Components}" IsVisible="{Binding HasComponents}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OpenComponent">
              <Grid ColumnDefinitions="*,Auto" Margin="0,8">
                <TextBlock Classes="strong" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource PgFont.Mono}" FontSize="{StaticResource PgFontSize.Caption}"
                           Foreground="{StaticResource PgBrush.Text.Secondary}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
