<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PrivateGateway.Client.UI.ViewModels"
             xmlns:c="using:PrivateGateway.Client.UI.Controls"
             xmlns:l="using:PrivateGateway.Client.UI.Localization"
             x:Class="PrivateGateway.Client.UI.Views.MtuView"
             x:DataType="vm:MtuViewModel">
  <!-- Лист «Свой MTU» (доска 6). Рамку и тень дает окно. -->
  <DockPanel AutomationProperties.Name="{l:L core.mtuCustom.title}">
    <Border DockPanel.Dock="Top" Width="40" Height="4" CornerRadius="2" HorizontalAlignment="Center"
            Background="{StaticResource PgBrush.Control.Grabber}" />

    <Grid DockPanel.Dock="Top" Margin="0,12,0,0" ColumnDefinitions="*,Auto">
      <TextBlock Classes="status" Text="{l:L core.mtuCustom.title}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="icon" Width="40" Height="40" Command="{Binding CancelCommand}"
              Foreground="{StaticResource PgBrush.Text.Secondary}"
              ToolTip.Tip="{l:L card.close}" AutomationProperties.Name="{l:L card.close}">
        <c:Icon Data="{StaticResource Icon.Close}" Width="20" Height="20" StrokeThickness="2.2" />
      </Button>
    </Grid>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,8,*">
      <Button Classes="secondary" Height="50" HorizontalAlignment="Stretch" Command="{Binding CancelCommand}"
              Content="{l:L dialog.cancel}" />
      <Button x:Name="SaveMtu" Grid.Column="2" Classes="primary" Height="50" HorizontalAlignment="Stretch"
              Command="{Binding SaveCommand}" Content="{l:L subs.edit.save}" />
    </Grid>

    <StackPanel Margin="0,16,0,16" Spacing="6">
      <TextBlock Classes="small" Text="{l:L core.mtu.title}" FontWeight="SemiBold" Foreground="{StaticResource PgBrush.Text.Secondary}" />
      <TextBox x:Name="MtuValue" Classes="input" Text="{Binding Value}" PlaceholderText="{l:L core.mtu.placeholder}" MaxLength="4"
               FontFamily="{StaticResource PgFont.Mono}" AutomationProperties.Name="{l:L core.mtu.title}">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <TextBlock Classes="caption" Text="{l:L core.mtuCustom.note}" TextWrapping="Wrap" />
      <TextBlock x:Name="MtuError" Classes="caption" Text="{Binding Error}" IsVisible="{Binding HasError}"
                 TextWrapping="Wrap" Foreground="{StaticResource PgBrush.Status.Warning.Badge}" />
    </StackPanel>
  </DockPanel>
</UserControl>
