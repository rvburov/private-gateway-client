<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PrivateGateway.Client.UI.ViewModels"
             xmlns:c="using:PrivateGateway.Client.UI.Controls"
             xmlns:l="using:PrivateGateway.Client.UI.Localization"
             x:Class="PrivateGateway.Client.UI.Views.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">
  <!-- Настройки — docs/design, доска 4. -->
  <ScrollViewer Classes="page" c:ScrollMemory.Remember="True">
    <StackPanel Margin="20,0">
      <TextBlock Classes="h1" Text="{l:L page.settings.title}" Margin="0,18,0,12" />

      <TextBlock Classes="overline" Text="{l:L settings.section.basic, Upper=True}" Margin="6,0,6,8" />
      <Border Classes="card" Padding="16,4">
        <StackPanel>
          <!-- Режим -->
          <StackPanel Spacing="10" Margin="0,14">
            <TextBlock Classes="strong" Text="{l:L settings.mode.title}" />
            <Border Classes="segments">
              <UniformGrid Columns="2">
                <RadioButton Classes="segment" GroupName="mode" IsChecked="{Binding IsVpnMode}" Content="{l:L settings.mode.vpn}" />
                <RadioButton Classes="segment" GroupName="mode" IsChecked="{Binding IsProxyMode}" Content="{l:L settings.mode.proxy}" />
              </UniformGrid>
            </Border>
            <TextBlock Classes="caption" Text="{Binding ModeNote}" TextWrapping="Wrap" />
          </StackPanel>
          <Border Classes="divider" />

          <Grid ColumnDefinitions="*,Auto" Margin="0,13">
            <StackPanel Spacing="3" Margin="0,0,16,0">
              <TextBlock Classes="strong" Text="{l:L settings.ks.title}" />
              <TextBlock Classes="caption" Text="{l:L settings.ks.text}" TextWrapping="Wrap" />
            </StackPanel>
            <c:ConfirmSwitch x:Name="KillSwitchToggle" Grid.Column="1" Classes="switch" VerticalAlignment="Center"
                             IsEnabled="{Binding CanKillSwitch}" IsChecked="{Binding KillSwitch, Mode=OneWay}"
                             Command="{Binding FlipKillSwitchCommand}" AutomationProperties.Name="{l:L settings.ks.title}" />
          </Grid>
          <Border Classes="divider" />

          <Grid ColumnDefinitions="*,Auto" Margin="0,13">
            <StackPanel Spacing="3" Margin="0,0,16,0">
              <TextBlock Classes="strong" Text="{Binding AutostartTitle}" />
              <TextBlock Classes="caption" Text="{l:L settings.autostart.text}" />
            </StackPanel>
            <ToggleButton Grid.Column="1" Classes="switch" VerticalAlignment="Center"
                          IsChecked="{Binding StartWithSystem}" AutomationProperties.Name="{Binding AutostartTitle}" />
          </Grid>
          <Border Classes="divider" />

          <Grid ColumnDefinitions="*,Auto" Margin="0,13">
            <StackPanel Spacing="3" Margin="0,0,16,0">
              <TextBlock Classes="strong" Text="{l:L settings.connectOnLaunch.title}" />
              <TextBlock Classes="caption" Text="{l:L settings.connectOnLaunch.text}" />
            </StackPanel>
            <ToggleButton Grid.Column="1" Classes="switch" VerticalAlignment="Center"
                          IsChecked="{Binding ConnectOnLaunch}" AutomationProperties.Name="{l:L settings.connectOnLaunch.title}" />
          </Grid>
          <Border Classes="divider" />

          <Grid ColumnDefinitions="*,Auto" Margin="0,13">
            <StackPanel Spacing="3" Margin="0,0,16,0">
              <TextBlock Classes="strong" Text="{l:L settings.tray.title}" />
              <TextBlock Classes="caption" Text="{l:L settings.tray.text}" />
            </StackPanel>
            <ToggleButton Grid.Column="1" Classes="switch" VerticalAlignment="Center"
                          IsChecked="{Binding MinimizeToTray}" AutomationProperties.Name="{l:L settings.tray.title}" />
          </Grid>
          <Border Classes="divider" />

          <!-- Уведомления -->
          <StackPanel Spacing="10" Margin="0,13">
            <StackPanel Spacing="3">
              <TextBlock Classes="strong" Text="{l:L settings.notifications.title}" />
              <TextBlock Classes="caption" Text="{Binding NotificationsNote}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Classes="segments">
              <UniformGrid Columns="3">
                <RadioButton Classes="segment" GroupName="notify" IsChecked="{Binding NotifyAll}" Content="{l:L settings.notifications.all}" />
                <RadioButton Classes="segment" GroupName="notify" IsChecked="{Binding NotifyImportant}" Content="{l:L settings.notifications.important}" />
                <RadioButton Classes="segment" GroupName="notify" IsChecked="{Binding NotifyOff}" Content="{l:L settings.notifications.off}" />
              </UniformGrid>
            </Border>
          </StackPanel>
          <Border Classes="divider" />

          <!-- Язык -->
          <Grid ColumnDefinitions="*,190" Margin="0,13">
            <TextBlock Classes="strong" Text="{l:L settings.language.title}" VerticalAlignment="Center" />
            <Border Grid.Column="1" Classes="segments">
              <UniformGrid Columns="2">
                <RadioButton x:Name="LanguageRu" Classes="segment" GroupName="lang" IsChecked="{Binding IsRussian}" Content="{l:L settings.language.ru}" />
                <RadioButton x:Name="LanguageEn" Classes="segment" GroupName="lang" IsChecked="{Binding IsEnglish}" Content="{l:L settings.language.en}" />
              </UniformGrid>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Classes="overline" Text="{l:L settings.section.advanced, Upper=True}" Margin="6,18,6,8" />
      <Border Classes="card" Padding="8,4">
        <!-- Строки разделены полосами, как в «Проверке» и «Компонентах» (решение 486); над первой полосы нет -->
        <ItemsControl Classes="divided" ItemsSource="{Binding Advanced}">
          <ItemsControl.Styles>
            <Style Selector="ItemsControl.divided ContentPresenter:nth-child(1) Border.between">
              <Setter Property="IsVisible" Value="False" />
            </Style>
          </ItemsControl.Styles>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AdvancedLinkViewModel">
              <StackPanel>
                <Border Classes="divider between" Margin="8,0" />
                <Button Classes="plain" Padding="8,10" Command="{Binding OpenCommand}" CommandParameter="{Binding Id}"
                        AutomationProperties.Name="{Binding Title}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="36" Height="36" CornerRadius="{StaticResource PgRadius.Input}"
                            Background="{StaticResource PgBrush.Accent.Tint}">
                      <c:Icon Data="{Binding Icon, Converter={StaticResource IconKey}}" Width="20" Height="20"
                              StrokeThickness="1.9" Foreground="{StaticResource PgBrush.Accent.Text}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="strong" Text="{Binding Title}" />
                      <TextBlock Classes="caption" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <c:Icon Classes="chevron" Grid.Column="2" Data="{StaticResource Icon.ChevronRight}" Width="16" Height="16"
                            StrokeThickness="2" />
                  </Grid>
                </Button>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <TextBlock Classes="caption" Text="{Binding Footer}" HorizontalAlignment="Center" Margin="0,14,0,0" />
      <Border Height="{StaticResource PgLayout.ScrollBottomPadding}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
