<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Привилегированная служба: запускает ядро, поднимает TUN, держит блок при обрыве и DNS.
    Windows — служба Windows, Linux — systemd. Интерфейс общается с ней только по IPC
    (shared/specifications/ipc), ссылаться на этот проект ему запрещено.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>PrivateGateway.Service</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Client.Core/Client.Core.csproj" />
    <ProjectReference Include="../Client.Contracts/Client.Contracts.csproj" />
    <ProjectReference Include="../Client.Network/Client.Network.csproj" />
    <ProjectReference Include="../Client.Platform.Windows/Client.Platform.Windows.csproj" />
    <ProjectReference Include="../Client.Platform.Linux/Client.Platform.Linux.csproj" />
    <ProjectReference Include="../Client.Platform.MacOS/Client.Platform.MacOS.csproj" />
  </ItemGroup>

  <!-- Открытые ключи подписи обновлений: служба ставит только выпуск с манифестом, подписанным одним из них. -->
  <ItemGroup>
    <EmbeddedResource Include="../../../shared/update/keys/*.pem" LogicalName="update-keys/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Grpc.AspNetCore.Server" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

  <!-- Счетчики ядра Xray для общей скорости: служба — клиент его StatsService на 127.0.0.1. -->
  <ItemGroup>
    <Protobuf Include="Cores/XrayStats.proto" GrpcServices="Client" Access="Internal" />
  </ItemGroup>

  <!-- macOS трактует окончание .Service особо: для native apphost нужно имя без этого суффикса.
       Имя управляемой сборки и контрактов не меняется. -->
  <Target Name="CopyMacServiceHostForBuild" AfterTargets="Build"
          Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))) or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">
    <Copy SourceFiles="$(TargetDir)PrivateGateway.Service" DestinationFiles="$(TargetDir)PrivateGatewayService" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyMacServiceHostForPublish" AfterTargets="Publish"
          Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">
    <Copy SourceFiles="$(PublishDir)PrivateGateway.Service" DestinationFiles="$(PublishDir)PrivateGatewayService" SkipUnchangedFiles="true" />
  </Target>

</Project>
