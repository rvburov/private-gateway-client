root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,xml,axaml,xaml,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sh]
end_of_line = lf

[*.cs]
# Стиль: file-scoped namespace, var там, где тип очевиден, using вне namespace.
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_prefer_braces = when_multiline:suggestion
dotnet_style_readonly_field = true:warning

# Имена: приватные поля — _camelCase, константы и статические readonly — PascalCase.
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_rule.constants.symbols = constants
dotnet_naming_rule.constants.style = pascal
dotnet_naming_rule.constants.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case

# Порядок правил важен: константы проверяются раньше приватных полей.
dotnet_naming_rule.constants.priority = 1
dotnet_naming_rule.private_fields.priority = 2

[desktop/src/Client.UI/ViewModels/*.cs]
# Свойства моделей представлений — цели привязок разметки; статические Avalonia не привязывает,
# поэтому совет CA1822 «сделать статическим» здесь вреден.
dotnet_diagnostic.CA1822.severity = none
